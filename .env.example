# --- AI provider (backend launches fine even if unset) ---
AI_PROVIDER=            # anthropic | openai | mock | (empty = disabled)
ANTHROPIC_API_KEY=      # only if AI_PROVIDER=anthropic
OPENAI_API_KEY=         # reserved (OpenAI adapter not implemented yet)
AI_MODEL=               # e.g. claude-3-5-sonnet-20241022

ENABLE_AI=true
ENABLE_MACRO=true
MAX_DAILY_ACTIONS=15
MAX_CONTEXT_ITEMS_PER_CATEGORY=20

# --- deterministic inflation fallback (fraction, e.g. 0.40 = %40) ---
MANUAL_INFLATION_RATE=

# --- data + db ---
DATA_FOLDER=./data
AGENT_DB=./data/agent_state.db
