# Copy to .env and fill in locally. NEVER commit .env. Names only here — no real values.

# --- AI provider (backend and dashboard work fully with AI disabled) ---
# disabled | openai | mock | anthropic
AI_PROVIDER=disabled
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override; default per provider lives in config.DEFAULT_MODELS
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=4000
# SDK retries for transient errors (429/5xx/connection), 0-3
AI_MAX_RETRIES=1
# Reasoning models only: low | medium | high. Empty = provider default for the default
# model (openai/gpt-5-mini -> low); 'none' = never send.
AI_REASONING_EFFORT=

ENABLE_AI=true
ENABLE_MACRO=true
MAX_DAILY_ACTIONS=15
MAX_CONTEXT_ITEMS_PER_CATEGORY=20

# Deterministic inflation fallback (fraction, e.g. 0.40 = %40). Empty = unavailable.
MANUAL_INFLATION_RATE=

# --- private local data + state (both gitignored) ---
DATA_FOLDER=./data
AGENT_DB=./data/agent_state.db

# --- M7 owner / management view (optional, selected paths only; do not auto-discover) ---
# Configure these ONLY in your private .env after choosing an actual local workbook.
# Setting a path does not designate a file of record.
# Never infer a snapshot date from file modification time or latest payment.
# Dates: YYYY-MM-DD, years: YYYY. Empty = unknown/not configured.
HEDEF_PATH=
HEDEF_SNAPSHOT_DATE=
KREDI_PATH=
KREDI_SNAPSHOT_DATE=
GIDER_GELIR_PATH=
GIDER_GELIR_REPORT_YEAR=
BUTCE_PATH=
BUTCE_PLANNING_YEAR=
BUTCE_SNAPSHOT_DATE=

# --- M8-CP1 owner administration login (D-060) ---
# Viewing the dashboard needs no login. Uploads / refresh, CRM / follow-up / fair / action changes, paid AI and the
# Yönetim section need the owner password. Generate the hash locally (prompts twice, prints ONE line):
#   python -m services.owner_auth hash-password
# and paste that line here in your PRIVATE .env (never commit it). Empty = administration disabled (fail closed).
HALSA_OWNER_PASSWORD_HASH=
# Session limits (bounded): absolute hours (1–72, default 12) and idle minutes (5–720, default 120).
HALSA_SESSION_HOURS=12
HALSA_SESSION_IDLE_MINUTES=120
# Only behind an HTTPS reverse proxy that is not forwarding the scheme: force the Secure cookie flag.
HALSA_COOKIE_SECURE=
