# Copy to .env and fill in locally. NEVER commit .env. Names only here — no real values.

# --- AI provider (backend and dashboard work fully with AI disabled) ---
# disabled | openai | mock | anthropic
AI_PROVIDER=disabled
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override; default per provider lives in config.DEFAULT_MODELS
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=4000
# SDK retries for transient errors (429/5xx/connection), 0-3
AI_MAX_RETRIES=1
# Reasoning models only: low | medium | high. Empty = provider default for the default
# model (openai/gpt-5-mini -> low); 'none' = never send.
AI_REASONING_EFFORT=

ENABLE_AI=true
ENABLE_MACRO=true
MAX_DAILY_ACTIONS=15
MAX_CONTEXT_ITEMS_PER_CATEGORY=20

# Deterministic inflation fallback (fraction, e.g. 0.40 = %40). Empty = unavailable.
MANUAL_INFLATION_RATE=

# --- private local data + state (both gitignored) ---
DATA_FOLDER=./data
AGENT_DB=./data/agent_state.db
